{
  "name": "logistics-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "playwright test --config=backend/test/browser/playwright.config.ts",
    "test:browser:headed": "playwright test --config=backend/test/browser/playwright.config.ts --headed",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace backend",
    "db:migrate:status": "npm run db:migrate:status --workspace backend",
    "infra:check": "npm run infra:check --workspace backend"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "typescript": "6.0.3",
    "multer": "2.3.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "js-yaml@^3": "3.15.2",
    "js-yaml@^4": "4.3.2"
  }
}
