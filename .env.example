# Copy this file to .env for local development. Never commit real credentials.
# Production must set NODE_ENV=production and replace every example credential/host.
# Complete staging/production template: deploy/.env.example; release gates: docs/DEPLOYMENT.md.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true

# Neon pooled runtime connection and direct migration connection.
# Local Docker alternative (both URLs): postgresql://demo:demo-local-only@127.0.0.1:55433/logistics_demo
# Follow README.md and docs/DEMO.md; keep the demo DB separate from disposable test DBs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=verify-full
# Optional Prisma replay/drift database, always disposable and separate from both URLs above.
# Never set this to a production database or reuse its pooled/direct alias.
SHADOW_DATABASE_URL=

REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=logistics-api
JWT_AUDIENCE=logistics-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=15
CACHE_TRACKING_TTL_SECONDS=60
CACHE_SHIPMENT_TTL_SECONDS=60

# Road routing is fail-safe disabled until a production provider is approved.
# Development may opt into an explicitly configured OSRM endpoint (public demos have no SLA).
ROUTE_PROVIDER=DISABLED
ROUTE_PROVIDER_BASE_URL=
ROUTE_TIMEOUT_MS=2500
ROUTE_CACHE_TTL_SECONDS=900
ROUTE_GEOMETRY_MAX_POINTS=2000
ROUTE_BATCH_CONCURRENCY=4
ROUTE_BATCH_EXTERNAL_CALL_LIMIT=20
LINE_HAUL_ROUTE_DEVIATION_METERS=500
LINE_HAUL_ROUTE_DEVIATION_CONSECUTIVE_SAMPLES=3
# Empty = compatibility. Set a stable UTC ISO cutover only after readiness + real trip smoke.
# Keep an existing environment's cutover stable. See docs/DOMAIN.md and docs/DEMO.md.
LINE_HAUL_ENFORCEMENT_FROM=

# Shipping-fee online payment is fail-safe disabled until a canonical provider is approved.
# TEST is only an explicit development/test adapter; never enable it in production.
PAYMENT_PROVIDER=DISABLED
PAYMENT_TEST_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_MS=5000

# Async email delivery. Leave disabled until a development/production SMTP account is configured.
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM=Logistics Operations <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
PASSWORD_RESET_URL=http://localhost:5173/reset-password

REFRESH_COOKIE_NAME=logistics_refresh
# Development/same-site only. Cross-site HTTPS production requires none;
# see deploy/render-auth.env.example for separate Render staging sites.
REFRESH_COOKIE_SAME_SITE=lax
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000
VITE_API_DOCS_URL=http://localhost:3000/api/docs
VITE_LOCATION_MODE=REAL

# Production notes:
# - Use HTTPS FRONTEND_URL/PASSWORD_RESET_URL and a managed REDIS_URL (prefer rediss://).
# - Use REFRESH_COOKIE_NAME=__Secure-logistics_refresh.
# - Set TRUST_PROXY_HOPS only to the exact number of trusted reverse proxies.
# - Keep SWAGGER_ENABLED=false unless the API documentation is intentionally exposed.
# - Use HTTPS VITE_* URLs, or omit API/socket URLs for a same-origin deployment.
# - Keep ROUTE_PROVIDER=DISABLED, PAYMENT_PROVIDER=DISABLED and VITE_LOCATION_MODE=REAL.
# - Remove PAYMENT_TEST_WEBHOOK_SECRET and ROUTE_PROVIDER_BASE_URL from production secrets.
# - Deploy one backend instance until distributed socket/rate-limit outage support is reviewed.
# - DIRECT_URL/SHADOW_DATABASE_URL belong to controlled migration jobs, not the API runtime.
# - See docs/DEPLOYMENT.md and docs/FINAL_PROJECT_CLOSURE_20261009.md for release gates/evidence.

# Backend-only LocationIQ Free search; blank disables address search.
LOCATIONIQ_API_KEY=

# Control Tower operational defaults (elapsed minutes, 24/7; not customer promises)
SLA_PICKUP_MINUTES=480
SLA_ORIGIN_DWELL_MINUTES=720
SLA_TRANSIT_MINUTES=1440
SLA_DESTINATION_DWELL_MINUTES=720
SLA_DELIVERY_MINUTES=480
SLA_AT_RISK_PERCENT=80
CONTROL_TOWER_AGING_MINUTES=360
