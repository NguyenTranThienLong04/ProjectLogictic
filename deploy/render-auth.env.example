# Non-secret API settings for the separate Render staging web/API sites.
# Apply to logistics-staging-api in Render Environment; Save and deploy.
# This file is documentation, not an automatically loaded runtime env.
NODE_ENV=production
FRONTEND_URL=https://logistics-staging-web.onrender.com
REFRESH_COOKIE_NAME=__Secure-logistics_refresh
REFRESH_COOKIE_SAME_SITE=none
# Cookie remains HttpOnly, Secure, host-only and Path=/api/v1/auth.
# Do not set Domain=onrender.com. SameSite=Lax remains suitable for the
# same-origin reverse-proxy deployment in staging.compose.yml.
# After applying, sign in again: previously blocked cookies do not exist.
