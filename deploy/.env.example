# Staging/production runtime template. Provision values in your secret manager; no real secrets here.
# deploy/staging.compose.yml uses this runtime env only for the backend.
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://logistics.staging.example.com
PASSWORD_RESET_URL=https://logistics.staging.example.com/reset-password
TRUST_PROXY_HOPS=2
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://RUNTIME_USER:PASSWORD@DB-pooler.neon.tech/STAGING_DB?sslmode=verify-full
REDIS_URL=rediss://REDIS_USER:PROVISION_PASSWORD@REDIS_HOST:6380/0
JWT_ACCESS_SECRET=replace-with-a-provisioned-random-secret-minimum-32-characters
JWT_ISSUER=logistics-api
JWT_AUDIENCE=logistics-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=15
REFRESH_COOKIE_NAME=__Secure-logistics_refresh
REFRESH_COOKIE_SAME_SITE=lax
CACHE_TRACKING_TTL_SECONDS=60
CACHE_SHIPMENT_TTL_SECONDS=60
ROUTE_PROVIDER=DISABLED
ROUTE_TIMEOUT_MS=2500
ROUTE_CACHE_TTL_SECONDS=900
ROUTE_GEOMETRY_MAX_POINTS=2000
ROUTE_BATCH_CONCURRENCY=4
ROUTE_BATCH_EXTERNAL_CALL_LIMIT=20
LINE_HAUL_ROUTE_DEVIATION_METERS=500
LINE_HAUL_ROUTE_DEVIATION_CONSECUTIVE_SAMPLES=3
PAYMENT_PROVIDER=DISABLED
PAYMENT_TIMEOUT_MS=5000
EMAIL_DELIVERY_ENABLED=true
EMAIL_FROM=Logistics Operations <no-reply@staging.example.com>
SMTP_HOST=SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=PROVISION_USER
SMTP_PASSWORD=PROVISION_PASSWORD
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Deployment-job environment, supplied separately (never expose in frontend or backend runtime):
# DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@DB.neon.tech/STAGING_DB?sslmode=verify-full
# SHADOW_DATABASE_URL=postgresql://SHADOW_USER:PASSWORD@SHADOW_HOST/DISPOSABLE_DB?sslmode=verify-full
# BACKEND_IMAGE=REGISTRY/logistics-backend@sha256:VERIFIED_DIGEST
# FRONTEND_IMAGE=REGISTRY/logistics-frontend@sha256:VERIFIED_DIGEST
# MIGRATION_IMAGE=REGISTRY/logistics-migration@sha256:VERIFIED_DIGEST
# STAGING_ENV_FILE=/protected/path/staging-runtime.env
# Build-time public values are fixed in Dockerfile: VITE_API_URL=/api/v1, VITE_SOCKET_URL=/,
# VITE_API_DOCS_URL= (empty), VITE_LOCATION_MODE=REAL. No simulation release artifact.
# Do not provision PAYMENT_TEST_WEBHOOK_SECRET or ROUTE_PROVIDER_BASE_URL.
